# Backend database. Docker Compose supplies its own PostgreSQL URL.
DATABASE_URL=sqlite:///./candidate_platform.db
# Generate a unique, high-entropy value for every non-development environment.
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Comma-separated list of exact frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Private storage location for uploaded documents (not a public static directory).
STORAGE_PATH=./storage

# Frontend (Vite)
VITE_API_URL=http://localhost:8000
